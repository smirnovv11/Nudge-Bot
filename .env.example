# Get this token from Telegram BotFather and put the real value in .env.
BOT_TOKEN=replace-me

# Local app connects to PostgreSQL published by docker compose on localhost:5432.
DATABASE_URL=postgresql+asyncpg://nudge:nudge@localhost:5432/nudge
DEFAULT_TIMEZONE=Europe/Minsk
DEFAULT_REPEAT_INTERVAL_MINUTES=5
SCHEDULER_POLL_INTERVAL_SECONDS=10
LOG_LEVEL=INFO
